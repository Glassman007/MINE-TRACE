{
  "$defs": {
    "ComponentDescriptor": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "format": "uuid",
          "title": "Component Id",
          "type": "string"
        },
        "component_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Type"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "machine_id": {
          "format": "uuid",
          "title": "Machine Id",
          "type": "string"
        },
        "manufacturer": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "component_id",
        "machine_id"
      ],
      "title": "ComponentDescriptor",
      "type": "object"
    },
    "MachineDescriptor": {
      "additionalProperties": false,
      "properties": {
        "asset_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Code"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "machine_id": {
          "format": "uuid",
          "title": "Machine Id",
          "type": "string"
        },
        "machine_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Type"
        },
        "manufacturer": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "site_area": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Area"
        },
        "site_name": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Name"
        }
      },
      "required": [
        "machine_id"
      ],
      "title": "MachineDescriptor",
      "type": "object"
    },
    "MaintenanceActionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Action Type",
          "type": "string"
        },
        "component_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Id"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "machine_id": {
          "format": "uuid",
          "title": "Machine Id",
          "type": "string"
        },
        "original_timestamp": {
          "format": "date-time",
          "title": "Original Timestamp",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        },
        "session_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        }
      },
      "required": [
        "action_id",
        "machine_id",
        "incident_id",
        "action_type",
        "original_timestamp"
      ],
      "title": "MaintenanceActionSnapshot",
      "type": "object"
    },
    "OperatingSessionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "machine_id": {
          "format": "uuid",
          "title": "Machine Id",
          "type": "string"
        },
        "operating_hours": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating Hours"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "state": {
          "maxLength": 64,
          "minLength": 1,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "machine_id",
        "started_at",
        "state"
      ],
      "title": "OperatingSessionSnapshot",
      "type": "object"
    },
    "VerificationRunSnapshot": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "incident_id": {
          "format": "uuid",
          "title": "Incident Id",
          "type": "string"
        },
        "original_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Timestamp"
        },
        "outcome_payload": {
          "additionalProperties": true,
          "title": "Outcome Payload",
          "type": "object"
        },
        "result": {
          "anyOf": [
            {
              "enum": [
                "SUCCEEDED",
                "RECURRENCE_DETECTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "rule_identifier": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Identifier"
        },
        "session_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "source_machine_id": {
          "format": "uuid",
          "title": "Source Machine Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "verification_run_id": {
          "format": "uuid",
          "title": "Verification Run Id",
          "type": "string"
        },
        "window_ends_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Ends At"
        }
      },
      "required": [
        "verification_run_id",
        "incident_id",
        "source_machine_id",
        "started_at"
      ],
      "title": "VerificationRunSnapshot",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentDescriptor"
      },
      "title": "Components",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "machine": {
      "$ref": "#/$defs/MachineDescriptor"
    },
    "maintenance_actions": {
      "items": {
        "$ref": "#/$defs/MaintenanceActionSnapshot"
      },
      "title": "Maintenance Actions",
      "type": "array"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "report_revision": {
      "minimum": 1,
      "title": "Report Revision",
      "type": "integer"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "session": {
      "$ref": "#/$defs/OperatingSessionSnapshot"
    },
    "verification_runs": {
      "items": {
        "$ref": "#/$defs/VerificationRunSnapshot"
      },
      "title": "Verification Runs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "report_revision",
    "generated_at",
    "machine",
    "session"
  ],
  "title": "MachineSessionReport",
  "type": "object",
  "x-mine-trace-schema-version": "1.0.0"
}
