# Application
MINE_TRACE_APP_NAME=MINE-TRACE Global Backend
MINE_TRACE_ENVIRONMENT=development
MINE_TRACE_API_PREFIX=
MINE_TRACE_LOG_LEVEL=INFO

# Canonical central PostgreSQL store. Use deployment-injected credentials in real environments.
MINE_TRACE_DATABASE_URL=postgresql+psycopg://mine_trace:change-me@localhost:5432/mine_trace
MINE_TRACE_DB_POOL_SIZE=10
MINE_TRACE_DB_MAX_OVERFLOW=20
MINE_TRACE_DB_POOL_TIMEOUT_SECONDS=30
MINE_TRACE_DB_POOL_RECYCLE_SECONDS=1800

# Edge authentication. JSON object mapping machine UUID -> sha256 token digest.
# Generate a digest outside source control; never place raw bearer tokens here.
MINE_TRACE_EDGE_NODE_TOKEN_HASHES={}

# Retained read-model limits.
MINE_TRACE_HISTORY_LOOKBACK_DAYS=30
MINE_TRACE_EVIDENCE_BUNDLE_LIMIT=100

# Optional semantic-memory configuration. Qdrant is derived and never canonical.
MINE_TRACE_SEMANTIC_SEARCH_ENABLED=false
MINE_TRACE_QDRANT_URL=
MINE_TRACE_QDRANT_API_KEY=
MINE_TRACE_QDRANT_COLLECTION=mine_trace_evidence
MINE_TRACE_QDRANT_TIMEOUT_SECONDS=3
MINE_TRACE_QDRANT_DISTANCE=cosine
MINE_TRACE_EMBEDDING_PROVIDER=fastembed
MINE_TRACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# No API key is required for FastEmbed. Model files download once and are then cached locally.
MINE_TRACE_EMBEDDING_API_KEY=
MINE_TRACE_EMBEDDING_DIMENSION=384
MINE_TRACE_SEMANTIC_TOP_K=5
MINE_TRACE_SEMANTIC_SCORE_THRESHOLD=

# Optional advisory AI configuration. Disabled/fallback is valid.
MINE_TRACE_AI_ENABLED=false
MINE_TRACE_AI_PROVIDER=groq
MINE_TRACE_GROQ_API_KEY=
MINE_TRACE_AI_MODEL=
# Legacy optional providers may use MINE_TRACE_AI_API_KEY; standard fleet AI uses Groq.
MINE_TRACE_AI_API_KEY=
MINE_TRACE_AI_TIMEOUT_SECONDS=30
