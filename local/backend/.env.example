# Application
MINE_TRACE_APP_NAME=MINE-TRACE Backend
MINE_TRACE_ENVIRONMENT=development
MINE_TRACE_API_PREFIX=
MINE_TRACE_LOG_LEVEL=INFO

# SQLite is the authoritative local system of record in the accepted repository.
MINE_TRACE_DATABASE_URL=sqlite:///./mine_trace.db
MINE_TRACE_SQLITE_BUSY_TIMEOUT_MS=5000
MINE_TRACE_SQLITE_WAL_ENABLED=true

# Demo mode. Hardcoded presentation data is seeded only when explicitly enabled.
MINE_TRACE_DEMO_MODE=false

# Local node identity. Configure real values only in .env / deployment secrets, never here.
MINE_TRACE_LOCAL_MACHINE_ID=
MINE_TRACE_LOCAL_NODE_ID=
MINE_TRACE_TRANSPORT_SCHEMA_VERSION=1.0

# Deterministic incident-linking configuration.
MINE_TRACE_INCIDENT_LINKING_WINDOW_MINUTES=60
MINE_TRACE_INCIDENT_LINKING_RULE_IDENTIFIER=mvp.same-machine-component-compatible-event-window.v1
MINE_TRACE_INCIDENT_LINKING_RULE_NAME=MVP deterministic incident linking
# Pydantic-settings parses complex env values as JSON.
MINE_TRACE_INCIDENT_LINKING_ACTIVE_STATUSES=["OPEN","VERIFYING","RECURRED","VERIFIED"]
MINE_TRACE_INCIDENT_LINKING_ALLOW_IDENTICAL_EVENT_TYPE=true
MINE_TRACE_INCIDENT_LINKING_COMPATIBLE_EVENT_PAIRS={}

# Other deterministic configuration.
MINE_TRACE_HISTORY_LOOKBACK_DAYS=30
MINE_TRACE_VERIFICATION_WINDOW_MINUTES=30
MINE_TRACE_VERIFICATION_RULE_IDENTIFIER=mvp.no-event.v1
MINE_TRACE_VERIFICATION_RULE_NAME=MVP no-event verification
MINE_TRACE_EVIDENCE_BUNDLE_LIMIT=100

# Return-to-service policy. Site-specific blocking mappings must be explicitly configured.
MINE_TRACE_RETURN_TO_SERVICE_POLICY_IDENTIFIER=local.return-to-service.v1
MINE_TRACE_RETURN_TO_SERVICE_POLICY_REVISION=1
MINE_TRACE_RETURN_TO_SERVICE_DO_NOT_RETURN_INCIDENT_STATUSES=[]
MINE_TRACE_RETURN_TO_SERVICE_VERIFICATION_REQUIRED_INCIDENT_STATUSES=["VERIFYING"]
MINE_TRACE_RETURN_TO_SERVICE_DO_NOT_RETURN_VERIFICATION_RESULTS=[]
MINE_TRACE_RETURN_TO_SERVICE_VERIFICATION_REQUIRED_ON_PENDING_RUN=true

# Optional semantic-memory configuration. Qdrant is derived and never canonical.
# Enable only when the Qdrant and embedding settings below are configured.
MINE_TRACE_SEMANTIC_SEARCH_ENABLED=false
MINE_TRACE_QDRANT_URL=http://127.0.0.1:6333
MINE_TRACE_QDRANT_LOCATION=
MINE_TRACE_QDRANT_API_KEY=
MINE_TRACE_QDRANT_COLLECTION=mine_trace_evidence
MINE_TRACE_QDRANT_TIMEOUT_SECONDS=3
MINE_TRACE_QDRANT_DISTANCE=cosine
MINE_TRACE_EMBEDDING_PROVIDER=fastembed_local
MINE_TRACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MINE_TRACE_EMBEDDING_VECTOR_DIMENSION=384
MINE_TRACE_EMBEDDING_CACHE_LOCATION=./models/fastembed
MINE_TRACE_EMBEDDING_API_KEY=
MINE_TRACE_SEMANTIC_TOP_K=5
# Leave unset until calibrated for the selected embedding model.
MINE_TRACE_SEMANTIC_SCORE_THRESHOLD=

# Edge-to-global synchronization configuration. References point to externally
# managed secret/certificate material; do not paste secrets into this file.
MINE_TRACE_GLOBAL_BACKEND_BASE_URL=
MINE_TRACE_EDGE_CREDENTIAL_REFERENCE=
MINE_TRACE_EDGE_TOKEN_REFERENCE=
MINE_TRACE_EDGE_CERTIFICATE_REFERENCE=
MINE_TRACE_SYNC_TRANSPORT_TIMEOUT_SECONDS=10
MINE_TRACE_SYNC_RETRY_INITIAL_SECONDS=5
MINE_TRACE_SYNC_RETRY_MAX_SECONDS=300
MINE_TRACE_SYNC_RETRY_MAX_ATTEMPTS=10

# Optional advisory AI configuration. Independent from Qdrant.
MINE_TRACE_AI_ENABLED=false
MINE_TRACE_AI_PROVIDER=groq
MINE_TRACE_AI_MODEL=qwen/qwen3.8-27b
MINE_TRACE_GROQ_API_KEY=
MINE_TRACE_AI_TIMEOUT_SECONDS=30

# Explicit incident/evidence correction provenance.
MINE_TRACE_INCIDENT_CORRECTION_RULE_IDENTIFIER=mvp.explicit-incident-correction.v1
MINE_TRACE_INCIDENT_CORRECTION_RULE_NAME=MVP explicit incident association correction
